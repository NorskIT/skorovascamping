{
	"name": "skorovascamping",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24 <25"
	},
	"packageManager": "npm@11.16.0",
	"scripts": {
		"dev": "vite dev",
		"clean:cloudflare": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('.svelte-kit/cloudflare', { recursive: true, force: true }))\"",
		"build": "npm run clean:cloudflare && wrangler types --check && vite build",
		"build:beta": "PUBLIC_DEPLOY_TARGET=beta npm run build",
		"build:production": "PUBLIC_DEPLOY_TARGET=production npm run build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run clean:cloudflare && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"gen": "npm run clean:cloudflare && wrangler types",
		"deploy": "npm run build:production && wrangler deploy --env=\"\"",
		"deploy:beta": "npm run build:beta && wrangler deploy --env beta"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"vanilla-cookieconsent": "^3.1.0"
	}
}
