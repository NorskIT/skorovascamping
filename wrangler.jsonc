{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "skorovascamping",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "skorovascamping.no",
			"custom_domain": true
		}
	],
	"env": {
		"beta": {
			"name": "skorovascamping-beta",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "beta.skorovascamping.no",
					"custom_domain": true
				}
			]
		}
	}
}
