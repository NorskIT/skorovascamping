{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "skorovascamping",
	"compatibility_date": "2026-09-02",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "skorovascamping.no",
			"custom_domain": true
		},
		{
			"pattern": "www.skorovascamping.no",
			"custom_domain": true
		}
	],
	"env": {
		"beta": {
			"name": "skorovascamping-beta",
			"workers_dev": false,
			"preview_urls": false,
			"ratelimits": [
				{
					"name": "CONTACT_RATE_LIMITER",
					"namespace_id": "1002",
					"simple": { "limit": 5, "period": 60 }
				}
			],
			"routes": [
				{
					"pattern": "beta.skorovascamping.no",
					"custom_domain": true
				}
			]
		}
	}
}
